{
  "name": "skiptingar",
  "version": "0.1.0",
  "private": true,
  "description": "Icelandic hyphenation from the 2020 patterns, with new typographic rules that drop breaks that read badly, put in on the server as soft hyphens; Icelandic typesetting rules (no-break spaces, quotes); and CSS text-wrap to pair them with.",
  "license": "MIT AND CC-BY-4.0 AND CC0-1.0",
  "author": "Geir Ólafsson",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data/exceptions.txt",
    "LICENSE",
    "NOTICE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "size": "bun run scripts/size.ts",
    "bench": "bun run scripts/bench.ts"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "keywords": [
    "icelandic",
    "hyphenation",
    "typography",
    "typesetting",
    "íslenska",
    "orðskipting"
  ]
}
